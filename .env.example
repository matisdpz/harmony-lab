# Copy to .env and adjust. These values are for LOCAL DEVELOPMENT ONLY; use real secrets elsewhere.

# PostgreSQL (used by docker compose and by a locally running backend)
POSTGRES_DB=harmonylab
POSTGRES_USER=harmonylab
POSTGRES_PASSWORD=harmonylab
POSTGRES_PORT=5432

# Host ports for docker compose
BACKEND_PORT=8081
FRONTEND_PORT=3000

# Backend (only needed when running the backend outside Docker; defaults shown)
# DB_URL=jdbc:postgresql://localhost:5432/harmonylab
# DB_USERNAME=harmonylab
# DB_PASSWORD=harmonylab
# SERVER_PORT=8081
# APP_CORS_ALLOWED_ORIGINS=http://localhost:5173

# Frontend dev server (only needed if the backend is not on localhost:8081)
# VITE_API_PROXY_TARGET=http://localhost:8081
